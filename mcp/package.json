{
  "name": "usethishook-mcp",
  "version": "1.2.0",
  "description": "MCP server for useThisHook — search, docs, and examples for React hooks.",
  "license": "MIT",
  "author": {
    "name": "Senthil Kumar Thangavel",
    "url": "https://senthilkumar.mentorbridge.in"
  },
  "type": "module",
  "bin": {
    "usethishook-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "usethishook",
    "react-hooks",
    "cursor",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senthilkumar979/useThisHook.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/senthilkumar979/useThisHook/issues"
  },
  "homepage": "https://usethishook.mentorbridge.in"
}
