{
  "packageName": "usethishook",
  "github": {
    "owner": "senthilkumar979",
    "repo": "useThisHook"
  },
  "siteUrl": "https://usethishook.mentorbridge.in",
  "catalogPath": "../mcp/data/catalog.json",
  "repoRootRelative": "..",
  "dataDir": "data/snapshots",
  "reportsDir": "reports",
  "limits": {
    "maxHttpRequests": 25,
    "requestTimeoutMs": 10000,
    "maxRetries": 2,
    "minGithubRateLimitRemaining": 10,
    "llmTimeoutMs": 20000,
    "llmMaxOutputTokens": 1200,
    "llmMaxCallsPerRun": 1,
    "maxPrDiffLines": 40
  },
  "pullRequests": {
    "enabled": false
  },
  "content": {
    "installCommand": "npm install usethishook",
    "recentTutorialLookback": 8
  }
}
