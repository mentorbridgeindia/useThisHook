{
  "name": "usethishook-growth",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly zero-cost growth agent for usethishook — metrics, drafts, and docs audit.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "usethishook-growth": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "growth.config.json",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senthilkumar979/useThisHook.git",
    "directory": "growth"
  },
  "homepage": "https://usethishook.mentorbridge.in"
}
