{
  "name": "usethishook",
  "version": "1.2.0",
  "description": "Zero-dependency, tree-shakeable React hooks for state, browser APIs, forms, and promise-based dialogs. TypeScript. React 18+.",
  "license": "MIT",
  "author": {
    "name": "Senthil Kumar Thangavel",
    "url": "https://senthilkumar.mentorbridge.in"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "prepare": "husky",
    "check:secrets": "node scripts/check-secrets.mjs",
    "pack:check": "publint && attw --pack .",
    "verify:commit": "npm run check:secrets && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run pack:check",
    "verify:push": "npm run playground:build && npm audit --audit-level=high",
    "prepublishOnly": "npm run verify:commit",
    "playground:seo": "node scripts/generate-playground-seo.mjs",
    "social:clip": "node scripts/record-social-clip.mjs",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "npm run playground:seo && vite build --config playground/vite.config.ts",
    "playground:build:pages": "npm run playground:seo && GITHUB_PAGES=true vite build --config playground/vite.config.ts",
    "mcp:catalog": "node scripts/generate-mcp-catalog.mjs",
    "mcp:catalog:check": "node scripts/generate-mcp-catalog.mjs && git diff --exit-code -- mcp/data/catalog.json",
    "mcp:install": "npm --prefix mcp install",
    "mcp:build": "npm run mcp:catalog && npm --prefix mcp run build",
    "mcp:test": "npm --prefix mcp test",
    "mcp:typecheck": "npm --prefix mcp run typecheck",
    "mcp:verify": "npm run mcp:catalog:check && npm run mcp:typecheck && npm run mcp:test && npm run mcp:build",
    "growth:install": "npm --prefix growth install",
    "growth:test": "npm --prefix growth test",
    "growth:typecheck": "npm --prefix growth run typecheck",
    "growth:build": "npm --prefix growth run build",
    "growth:run": "npm --prefix growth start",
    "growth:verify": "npm run growth:typecheck && npm run growth:test && npm run growth:build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fingerprint/react": "^3.2.0",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^13.2.0",
    "goey-toast": "^0.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "custom-hooks",
    "hooks-library",
    "typescript",
    "typescript-hooks",
    "usethishook",
    "tree-shakeable",
    "zero-dependency",
    "ssr",
    "ssr-safe",
    "useLocalStorage",
    "useSessionStorage",
    "useDebounce",
    "useThrottle",
    "useBoolean",
    "useDisclosure",
    "useConfirm",
    "usePrompt",
    "useOverlay",
    "useStepFlow",
    "useScrollLock",
    "useDocumentVisibility",
    "useIdle",
    "useMediaQuery",
    "useFingerprint",
    "fingerprint",
    "react-utilities"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/senthilkumar979"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senthilkumar979/useThisHook.git"
  },
  "bugs": {
    "url": "https://github.com/senthilkumar979/useThisHook/issues"
  },
  "homepage": "https://usethishook.mentorbridge.in"
}
