{
  "name": "usethishook",
  "version": "0.4.0",
  "description": "A collection of reusable React hooks for everyday UI, state, and browser APIs.",
  "license": "MIT",
  "author": {
    "name": "Senthil Kumar Thangavel",
    "url": "https://senthilkumar.mentorbridge.in"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "prepare": "husky",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:commit": "npm run check:secrets && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:push": "npm run playground:build && npm audit --audit-level=high",
    "prepublishOnly": "npm run verify:commit",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground:build:pages": "GITHUB_PAGES=true vite build --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^13.2.0",
    "goey-toast": "^0.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "react",
    "hooks",
    "custom-hooks",
    "typescript",
    "usethishook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senthilkumar979/useThisHook.git"
  },
  "bugs": {
    "url": "https://github.com/senthilkumar979/useThisHook/issues"
  },
  "homepage": "https://usethishook.mentorbridge.in"
}
